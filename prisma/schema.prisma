// Event Platform Database Schema
// Milestone 1: Authentication + Event Creation

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
  engineType = "library"
  binaryTargets = ["native", "debian-openssl-1.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ============================================
// AUTHENTICATION & USER SYSTEM
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?   @unique
  password      String?   // Hashed password (optional for legacy/mixed auth)
  role          UserRole  @default(GUEST)
  
  // OTP Fields
  otpCode       String?
  otpExpires    DateTime?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // Soft delete support
  suspendedAt   DateTime? // Suspension timestamp (null = active)
  suspendedReason String? // Reason shown to suspended users

  // Relations
  accounts      Account[]
  sessions      Session[]
  events        Event[]   // Events created by this user (as host)
  rsvps         RSVP[]    // RSVPs made by this user (as guest)
  comments      Comment[] // Comments made by this user
  photos        Photo[]   // Photos uploaded by this user
  staffedEvents EventStaff[]
  scans         CheckIn[]
  sentMessages     ChatMessage[] @relation("SentMessages")
  receivedMessages ChatMessage[] @relation("ReceivedMessages")
  announcements    Announcement[]
  stripeAccount    StripeAccount?
  orders           Order[]
  
  @@index([email]) // Explicit index for faster lookups
  @@map("users")
}

enum UserRole {
  GUEST
  HOST
  ADMIN
  STAFF // New role for event ops
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// EVENT SYSTEM
// ============================================

model Event {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  description String?     @db.Text
  type        EventType   @default(EVENT)
  
  // Date & Time
  startDate   DateTime
  endDate     DateTime?
  timezone    String      @default("UTC")
  
  // Location
  locationType LocationType @default(PHYSICAL)
  location    String?
  virtualLink String?
  
  // Media
  coverImage  String?
  
  // Customization
  theme       Json?       // Store theme settings as JSON
  
  // Ticketing
  isPaid          Boolean         @default(false)

  // Admin Moderation
  isFeatured      Boolean         @default(false)
  isHidden        Boolean         @default(false)

  // Settings
  visibility      EventVisibility @default(PUBLIC)
  isPrivate       Boolean         @default(false)
  guestListHidden Boolean         @default(false)
  capacity        Int?        // Max guests (optional)
  rsvpDeadline    DateTime?   // RSVP deadline
  checkInWindowStart Int      @default(60) // Minutes before start QR is valid
  maxCheckIns     Int         @default(2)  // Max entries per QR
  status          EventStatus @default(DRAFT)
  
  // Host
  hostId      String
  host        User        @relation(fields: [hostId], references: [id], onDelete: Cascade)
  
  // Timestamps
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  publishedAt DateTime?
  deletedAt   DateTime?   // Soft delete support
  
  // Relations
  rsvps       RSVP[]
  comments    Comment[]
  photos      Photo[]
  invitations Invitation[]
  staff       EventStaff[]
  broadcasts  Broadcast[]
  chatMessages ChatMessage[]
  announcements Announcement[]
  ticketTiers  TicketTier[]
  orders       Order[]

  @@index([slug])
  @@index([hostId])
  @@index([status])
  @@index([startDate])
  @@index([isFeatured])
  @@index([status, visibility, startDate])
  @@map("events")
}

enum EventType {
  EVENT
  CARD
}

model Photo {
  id        String   @id @default(cuid())
  url       String
  createdAt DateTime @default(now())
  
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([eventId, createdAt])
  @@map("photos")
}

enum LocationType {
  PHYSICAL
  VIRTUAL
  HYBRID
}

enum EventVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  CLOSED
  ARCHIVED
}

// ============================================
// RSVP SYSTEM (Enhanced for Milestone 2)
// ============================================

model RSVP {
  id               String   @id @default(cuid())
  status           RSVPStatus
  waitlistPosition Int?     // Order in waitlist
  checkedIn        Boolean  @default(false)
  qrToken          String?  @unique // Generated on ACCEPTED
  qrExpiresAt      DateTime?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  userId           String?
  eventId          String
  guestName        String?
  guestEmail       String?
  guestPhone       String?  // Optional phone for SMS notifications
  otpCode          String?
  otpExpires       DateTime?
  
  orderId          String?  @unique // set when RSVP is created via paid ticket

  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checkIns         CheckIn[]
  order            Order?   @relation("OrderRSVP", fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, eventId])
  @@unique([eventId, guestEmail])
  @@index([eventId, status])
  @@index([userId])
  @@map("rsvps")
}

enum RSVPStatus {
  ACCEPTED
  MAYBE
  DECLINED
  PENDING
  WAITLISTED
  CANCELLED
}

// ============================================
// INVITATION SYSTEM
// ============================================

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model Invitation {
  id        String       @id @default(cuid())
  eventId   String
  email     String?      // Optional: null for phone-only invites
  phone     String?      // Optional: null for email-only invites
  token     String       @unique
  status    InviteStatus @default(PENDING)
  expiresAt DateTime
  sentAt    DateTime?
  createdAt DateTime     @default(now())

  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([email])
  @@index([phone])
  @@map("invitations")
}

// ============================================
// EVENT OPERATIONS (Staff & Check-in)
// ============================================

model EventStaff {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  role      String   @default("SCANNER")
  addedAt   DateTime @default(now())
  expiresAt DateTime // Auto-set to event.endDate

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_staff")
}

model CheckIn {
  id        String   @id @default(cuid())
  rsvpId    String
  scannedAt DateTime @default(now())
  scanCount Int      @default(0) // Max 2 (Entry, Re-entry)
  isBlocked Boolean  @default(false)
  staffId   String?  // Who scanned

  rsvp      RSVP     @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  staff     User?    @relation(fields: [staffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([rsvpId])
  @@index([staffId])
  @@index([scannedAt])
  @@map("check_ins")
}

// ============================================
// MESSAGING & NOTIFICATIONS
// ============================================

enum BroadcastAudience {
  ALL
  CONFIRMED
  PENDING
}

model Broadcast {
  id          String            @id @default(cuid())
  eventId     String
  message     String            @db.Text
  audience    BroadcastAudience
  sentAt      DateTime?
  scheduledAt DateTime?
  createdAt   DateTime          @default(now())

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([eventId, sentAt])
  @@map("broadcasts")
}

// ============================================
// SOCIAL INTERACTION SYSTEM
// ============================================

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  type      String   @default("TEXT") // TEXT, GIF, STICKER
  mediaUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventId   String
  userId    String

  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([eventId, createdAt])
  @@index([parentId])
  @@index([userId])
  @@map("comments")
}

// ============================================
// WHATSAPP SESSION STORAGE
// ============================================

model WhatsAppSession {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}

model ChatMessage {
  id          String   @id @default(cuid())
  content     String   @db.Text
  createdAt   DateTime @default(now())
  
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  
  // Group Chat Context
  eventId     String?
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  // Direct Message Context
  recipientId String?
  recipient   User?    @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  
  isRead      Boolean  @default(false)

  @@index([eventId])
  @@index([eventId, createdAt])
  @@index([senderId, recipientId])
  @@index([recipientId])
  @@map("chat_messages")
}

// ============================================
// ANNOUNCEMENTS
// ============================================

model Announcement {
  id        String   @id @default(cuid())
  content   String   @db.Text
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())

  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  hostId    String
  host      User     @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([eventId, isPinned])
  @@map("announcements")
}

// ============================================
// STRIPE CONNECT (Host Payouts)
// ============================================

model StripeAccount {
  id               String   @id @default(cuid())
  userId           String   @unique
  stripeAccountId  String   @unique // Stripe Connect acct_...
  chargesEnabled   Boolean  @default(false)
  payoutsEnabled   Boolean  @default(false)
  detailsSubmitted Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("stripe_accounts")
}

// ============================================
// TICKETING
// ============================================

model TicketTier {
  id           String   @id @default(cuid())
  eventId      String
  name         String   // e.g. "General Admission", "VIP"
  description  String?
  price        Int      // in cents (2500 = $25.00)
  currency     String   @default("usd")
  quantity     Int      // total available
  quantitySold Int      @default(0)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([eventId])
  @@map("ticket_tiers")
}

enum OrderStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

model Order {
  id                    String      @id @default(cuid())
  eventId               String
  ticketTierId          String
  userId                String?     // null for guest checkout
  guestEmail            String?
  guestName             String?
  quantity              Int         @default(1)
  unitPrice             Int         // price at purchase time (cents)
  totalAmount           Int         // quantity * unitPrice (cents)
  currency              String      @default("usd")
  status                OrderStatus @default(PENDING)
  stripePaymentIntentId String?     @unique
  stripeChargeId        String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  event                 Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTier            TicketTier  @relation(fields: [ticketTierId], references: [id], onDelete: Restrict)
  user                  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  rsvp                  RSVP?       @relation("OrderRSVP")

  @@index([eventId])
  @@index([eventId, status])
  @@index([userId])
  @@index([stripePaymentIntentId])
  @@index([status])
  @@map("orders")
}
